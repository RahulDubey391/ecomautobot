# Gumroad API v2 Credentials
# Generate at: https://app.gumroad.com/settings/advanced#application-form
GUMROAD_ACCESS_TOKEN=

# Gemini API Credentials (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Store Defaults
DEFAULT_CURRENCY=usd
GUMROAD_AUTO_PUBLISH=true

# Dev.to API Key (https://dev.to/settings/extensions -> DEV Community API Keys)
DEVTO_API_KEY=

# X (Twitter) OAuth 1.0a Credentials (https://developer.x.com -> Read and write)
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
